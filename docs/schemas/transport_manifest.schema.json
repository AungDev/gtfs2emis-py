{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AungDev/gtfs2emis-py/main/docs/schemas/transport_manifest.schema.json",
  "title": "gtfs2emis-py transport output manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version",
    "created_at",
    "input_sha256",
    "columns",
    "parameters",
    "shapes",
    "rows_total",
    "rows_written",
    "shapes_resumed",
    "shapes_total",
    "table_sha256",
    "skipped",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "parameters": {
      "type": "object"
    },
    "shapes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shape_id",
          "file",
          "rows",
          "status",
          "error"
        ],
        "properties": {
          "shape_id": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "rows": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "done",
              "failed"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "rows_total": {
      "type": "integer",
      "minimum": 1
    },
    "rows_written": {
      "type": "integer",
      "minimum": 0
    },
    "shapes_resumed": {
      "type": "integer",
      "minimum": 0
    },
    "shapes_total": {
      "type": "integer",
      "minimum": 1
    },
    "table_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "skipped": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
