{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AungDev/gtfs2emis-py/main/docs/schemas/emission_manifest.schema.json",
  "title": "gtfs2emis-py emission manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "ef_model",
    "pollutant",
    "process",
    "rows",
    "shapes",
    "columns",
    "request_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "ef_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "pollutant": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "process": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "integer",
      "minimum": 0
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shapes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shape_id",
          "file",
          "rows",
          "sha256"
        ],
        "properties": {
          "shape_id": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "pattern": "^shapes/.+\\.parquet$"
          },
          "rows": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
